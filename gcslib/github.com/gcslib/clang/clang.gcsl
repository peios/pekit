# The clang library: libclang, for what parses C with it, bindgen say.
#
# - `libclang_18()`: libclang 18.1.1, from the `libclang` wheel on PyPI,
#   pinned by its SHA-256: a directory holding `libclang.so`, which links
#   LLVM in and needs nothing of the system but glibc, for `LIBCLANG_PATH`.
#   It has no headers of its own: give it a C compiler's, as the rust
#   library's `cargo_build` does.
import unpack from archive

let WHEEL = "https://files.pythonhosted.org/packages/1d/fc/716c1e62e512ef1c160e7984a73a5fc7df45166f2ff3f254e71c58076f7c/libclang-18.1.1-py2.py3-none-manylinux2010_x86_64.whl"

def libclang_18() -> Dir {
    let wheel = fetch(WHEEL, sha256 = "c533091d8a3bbf7460a00cb6c1a71da93bffe148f172c7d03b1c31fbf8aa2a0b")
    = unpack(wheel).dir("libclang-18.1.1.data/platlib/clang/native")
}
