# The ppk library: packing `package` definitions as ppk packages.
#
# - `Toolchain::Ppk`: the ppk tool, a `PpkToolchain`: `root`, its install;
#   `runtime`, a root it runs on, `/` for the host's; and `ppk`, the
#   program. A workspace registers one in `pekitconf`, as it does a
#   compiler: ppk is not published, so the library pins none.
# - `pack(pkg)`: the artifact directory of the package `pkg`, a `Package`,
#   packed for `^platform`'s architecture, as `ppk pack` makes it in a new,
#   empty directory: a hermetic step, so the same files and version give
#   the same directory, and a package whose files did not change is not
#   packed again. The step is given the ppk program alone, so it packs in a
#   strict build too, with a static ppk. Copying it into an artifact store, which ppk refuses for
#   a version whose content changed, is publishing, which is no step.
#   The package's `ppk` field, if it has one, is its manifest's metadata:
#   `description`, `homepage`, `license`, `license_class` and
#   `source_license`, each a string, and `dependencies`, `requires`,
#   `provides`, `claims` and `descriptors`, each a record of strings, given
#   to `ppk pack` as its options of those names, `--depends` for
#   `dependencies` and `--descriptor` for `descriptors`. Any other field in
#   `ppk` is an error naming it. A file's signature is no field: it is a
#   file beside the one it signs, `<file>.peios.sig`, placed in `files`
#   like any other, which `ppk pack` records and does not pack.
# - `packager()`: ppk as a `packaging.Packager`, for a workspace to list in
#   `pekitconf.packagers`: its `pack` is `pack`, and its `publish` copies a
#   packed package into an artifact directory with `ppk fetch`, which
#   refuses a version whose content changed.
# - `PpkPackage`: a package as ppk packed it: its name, version and
#   architecture, and an artifact directory holding it.
# - `packed(pkg)`: the `PpkPackage` of `pkg`, packed as `pack` packs it.
# - `from_repository(repo, name, version)`: the `PpkPackage` of the version
#   `version` of the package `name`, for `^platform`'s architecture, taken
#   from the artifact directory `repo` with `ppk fetch`: a hermetic step,
#   keyed by the repository's contents, so what it gives is what the
#   repository holds. A repository is a directory of the workspace, until
#   Peios serves packages over the network.
import fs
import packaging
import toolchain
import Toolchain from toolchain

type PpkToolchain = {root: Dir, runtime: Dir, ppk: File}

enum Toolchain::Ppk<PpkToolchain>

#[hermetic]
def pack(pkg: Package, arch: String = this_arch(), ppk: File = program()) -> Dir {
    let files = fs.compose_dir(pkg.files)
    let out = working_dir().dir("artifacts")
    let ran = exec([
        ppk.path,
        "pack",
        "{pkg.name}@{pkg.version}?arch={arch}",
        files.path,
        "--artifact-dir",
        out.path,
        ...metadata_args(pkg),
    ])
    = out
}

# The fields of a package's `ppk` that are one value, each given to
# `ppk pack` as the option of its name with `-` for `_`, such as
# `--license-class <class>`.
let SINGLE_FIELDS = ["description", "homepage", "license", "license_class", "source_license"]

# The fields of a package's `ppk` that are tables, each entry given to
# `ppk pack` as `table_option(field)`, the entry's key and its value.
let TABLE_FIELDS = ["claims", "dependencies", "descriptors", "provides", "requires"]

# The `ppk pack` option of a table field: `--depends` for `dependencies`,
# `--descriptor` for `descriptors`, which gives each path its security
# descriptor in hexadecimal, and the field's own name for the others.
fn table_option(field: String) -> String {
    if field == "dependencies" {
        = "--depends"
    } else if field == "descriptors" {
        = "--descriptor"
    } else {
        = "--{field}"
    }
}

# The `ppk pack` options that give `pkg`'s manifest the metadata in its
# `ppk` field, in the order of its fields' names, or none if it has no
# `ppk`. A field ppk has no form for is an error naming it, so that a
# misspelt one is never silently left out.
fn metadata_args(pkg: Package) -> List<String> {
    # In the branch, `pkg` is a `{ppk: {}}`, and a `{}` fits `{*: *}`.
    let meta: {*: *} = if pkg is {ppk: {}} { = pkg.ppk } else { = {} }
    let mut args: List<String> = []
    for field in entries(meta) {
        args := [...args, ...field_args(pkg.name, field)]
    }
    = args
}

# The options of one field of the package `name`'s `ppk`.
fn field_args(name: String, field: {key: String, *: *}) -> List<String> {
    let key = field.key
    if SINGLE_FIELDS.contains(key) {
        if field is {value: String} {
            = ["--{key.split("_").join("-")}", field.value]
        } else {
            = panic("{name}: `ppk.{key}` is not a string")
        }
    } else if TABLE_FIELDS.contains(key) {
        if field is {value: {*: String}} {
            let mut args: List<String> = []
            for each in entries(field.value) {
                args := [...args, table_option(key), each.key, each.value]
            }
            = args
        } else {
            = panic("{name}: `ppk.{key}` is not a table of strings")
        }
    } else {
        = panic(
            "{name}: ppk has no field `{key}`; its fields are {[...SINGLE_FIELDS, ...TABLE_FIELDS].join(", ")}",
        )
    }
}

type PpkPackage = {name: String, version: String, arch: String, artifacts: Dir}

# The ppk program of the registered `Toolchain::Ppk`, which a step is given
# alone. The toolchain's `runtime` is `/`, the host's, which a hermetic step
# can't be given in a strict build, and a strict step sees nothing of the
# host's: so a strict build needs a ppk that runs on its own, a static one.
fn program(tool: PpkToolchain = toolchain.get(Toolchain::Ppk)) -> File {
    if tool.runtime.path != "/" {
        panic("the ppk library runs ppk on the host's runtime alone, not `{tool.runtime.path}`")
    }
    = tool.ppk
}

def packager() -> packaging.Packager {
    name = "ppk"
    pack = fn(pkg: Package) -> Dir { pack_of(pkg) }
    publish = fn(pkg: Package, packed: Dir, store: String) -> {} { published(pkg, packed, store) }
}

def packed(pkg: Package, arch: String = this_arch()) -> PpkPackage {
    name = pkg.name
    version = pkg.version
    arch = arch
    artifacts = pack(pkg, arch = arch)
}

#[hermetic]
def from_repository(
    repo: Dir,
    name: String,
    version: String,
    arch: String = this_arch(),
    ppk: File = program(),
) -> PpkPackage {
    let out = working_dir().dir("artifacts")
    let ran = exec([
        ppk.path,
        "fetch",
        "--from",
        repo.path,
        "{name}@{version}?arch={arch}",
        "--artifact-dir",
        out.path,
    ])
    name = name
    version = version
    arch = arch
    artifacts = out
}

# `pkg` packed, as `pack` packs it: the name a packager's function calls,
# since a field of the packager's own name would be the field.
fn pack_of(pkg: Package) -> Dir { pack(pkg) }

# `pkg`, packed into `packed`, copied into the artifact directory `store` by
# `ppk fetch`, outside any step.
fn published(
    pkg: Package,
    packed: Dir,
    store: String,
    arch: String = this_arch(),
    tool: PpkToolchain = toolchain.get(Toolchain::Ppk),
) -> {} {
    let ran = exec([
        tool.ppk.path,
        "fetch",
        "--from",
        packed.path,
        "{pkg.name}@{pkg.version}?arch={arch}",
        "--artifact-dir",
        store,
    ])
}

# The architecture packages are built for: `^platform`'s.
fn this_arch(^platform) -> String { platform.arch }
