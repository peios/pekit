# The python library: Python libraries and programs, built with an
# interpreter it asks the `toolchain` module for.
#
# - `Toolchain::Python`: a Python toolchain, a `PythonToolchain`: `root`, its
#   whole install; `runtime`, a root it runs on, `/` for the host's; and
#   `python`, the interpreter.
# - `python_3_14`: CPython 3.14 from python-build-standalone, pinned by its
#   SHA-256, running on x86-64 Linux, on the gcc library's Bootlin sysroot.
# - `system_python`: the host's own `python3`, found on `PATH`.
# - `library(srcs, deps)`: a `Library`, its sources, each checked to
#   compile, and every source its dependencies have, all the way down.
# - `binary(main, deps, output)`: one runnable file, `python3 OUTPUT`, of
#   the program `main` and every source its dependencies have, each at the
#   top of the archive by its name. Two sources of one name are an error;
#   one source reached twice is one. The archive's entries are sorted and
#   dated 1980, so that the same sources give the same bytes.
#
# A step's interpreter is resolved in a parameter default, as the gcc
# library's compilers are; a pinned one runs in a sandbox of its runtime, its
# install at `/opt/python` and each input at its own path.
import fs
import unpack from archive
import builtins
import toolchain
import Toolchain from toolchain
import * from "github.com/gcslib/gcc"

type PythonToolchain = {root: Dir, runtime: Dir, python: File}

enum Toolchain::Python<PythonToolchain>

type Library = {sources: List<File>}

let RELEASE = "https://github.com/astral-sh/python-build-standalone/releases/download/20261009"

def Toolchain::Python python_3_14() {
    let archive = fetch(
        "{RELEASE}/cpython-3.14.8%2B20261009-x86_64-unknown-linux-gnu-install_only.tar.gz",
        sha256 = "83f9cb480b702548c592443f86209cf0fc03448d90692df257f095c01791dccc",
    )
    let files = unpack(archive).dir("python")
    let registered = (Toolchain::C gcc_x86_64)()
    let c: Toolchain = registered.provides
    host_platform = {arch = "x86_64"; os = "linux"}
    platform = {}
    provides = {root = files; runtime = Toolchain::C.payload(c).runtime; python = files.file("bin/python3")}
}

def Toolchain::Python system_python() {
    host_platform = ^host_platform
    platform = {}
    provides = {root = dir("/usr"); runtime = dir("/"); python = builtins.which("python3")}
}

def library(srcs: List<File>, deps: List<Library> = []) -> Library {
    sources = [...(for src in srcs { check(src) }), ...sources_of(deps)]
}

def binary(main: File, deps: List<Library> = [], output: String = "app.pyz") -> File {
    = bundle(check(main), sources_of(deps), output)
}

# Every source of `deps`, in order. Lists are persistent, so each join
# shares the lists it joins, and a long chain of libraries copies nothing.
fn sources_of(deps: List<Library>) -> List<File> {
    let mut all: List<File> = []
    for dep in deps {
        all := [...all, ...dep.sources]
    }
    = all
}

# Where a pinned interpreter's install is placed in its sandbox.
let OPT = "/opt/python"

# The step's own directory as a sandbox's commands see it, where they write.
let OUT = "/.out"

# Compiles `src`, which writes nothing beside it, and a mark of its own.
let CHECK = "import sys\
    \ncompile(open(sys.argv[1], 'rb').read(), sys.argv[1], 'exec')\
    \nopen('checked', 'w').close()\
    \n"

# Writes the archive `out` of `main`, as `__main__.py`, and the sources
# after it, each by its name: sorted, dated 1980, as plain files.
let BUNDLE = "import sys, zipfile\
    \nout, main, sources = sys.argv[1], sys.argv[2], sys.argv[3:]\
    \nnamed = dict()\
    \nfor name, src in [('__main__.py', main)] + [(s.rsplit('/', 1)[-1], s) for s in sources]:\
    \n    if name in named and named[name] != src:\
    \n        sys.exit('two sources are named %s: %s and %s' % (name, named[name], src))\
    \n    named[name] = src\
    \nwith zipfile.ZipFile(out, 'w') as archive:\
    \n    for name in sorted(named):\
    \n        entry = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 0))\
    \n        entry.compress_type = zipfile.ZIP_DEFLATED\
    \n        entry.external_attr = 0o644 << 16\
    \n        archive.writestr(entry, open(named[name], 'rb').read())\
    \n"

# Checks that `src` compiles, and gives it, so that whatever uses it needs
# the check.
#[hermetic]
fn check(src: File, py: PythonToolchain = toolchain.get(Toolchain::Python)) -> File {
    let checked = run(py, ["-c", CHECK, src.path], [src], "checked")
    = src
}

#[hermetic]
fn bundle(
    main: File,
    sources: FileSet,
    output: String,
    py: PythonToolchain = toolchain.get(Toolchain::Python),
) -> File {
    let paths = for f in sources { f.path }
    = run(py, ["-c", BUNDLE, output, main.path, ...paths.unique()], [main, ...sources], output)
}

# Runs the interpreter of `py` with the arguments `words`, given the files
# `inputs`, and gives the file `output` it writes in the step's directory.
fn run(py: PythonToolchain, words: List<String>, inputs: FileSet, output: String) -> File {
    if py.runtime.path == "/" {
        let ran = exec([py.python.path, ...words], env = {PYTHONDONTWRITEBYTECODE = "1"})
        return file(output)
    }
    let prefix = "{py.root.path}/"
    if not py.python.path.starts_with(prefix) {
        panic("`{py.python.path}` is not in its toolchain's install, `{py.root.path}`")
    }
    let paths = for f in inputs { f.path }
    let placed: List<{at: String, place: Dir | File | FileSet}> = [
        {at = "/"; place = py.runtime},
        {at = OPT; place = py.root},
        ...(for at in paths.unique() { {at = at; place = file(at)} }),
    ]
    let box = fs.compose(placed).sandbox(
        cwd = OUT,
        env = {PYTHONDONTWRITEBYTECODE = "1"; HOME = OUT; TMPDIR = OUT},
    )
    let ran = box.exec("{OPT}/{py.python.path.strip_prefix(prefix)}", ...words)
    let made = file(output)
    fs.copy(box.file("{OUT}/{output}").path, made.path)
    = made
}
