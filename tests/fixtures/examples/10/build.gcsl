# Example 10, as it runs today: an ISO of the Peios kernel and busybox, from
# a repository beside this file, and packages built here, ppk among them,
# from its source in `ppk/`, booted to busybox's prompt by a test. Jack's
# draft is examples/10/build.gcsl; what it needs that does not exist yet is
# in design/image.md.
import "github.com/gcslib/peiso"
import "github.com/gcslib/ppk"
import "github.com/gcslib/qemu"

# The packages not built here, by name and version, from the repository,
# an artifact directory.
fn from_repository(name: String, version: String) -> ppk.PpkPackage {
    = ppk.from_repository(dir("repository"), name, version)
}

# The image: an ordinary build. Busybox is the initramfs's init, since
# prelude is not built yet, so the live-boot hook is carried but not run.
def build iso() {
    = peiso.iso(
        kernel = {package = from_repository("dev.peios.kernel", "0.25.0-indev-1"); cmdline = "console=ttyS0"},
        packages = [
            {package = from_repository("net.busybox.busybox", "1.37.0-1"); initramfs = true},
            {package = package dev.peios.ppk(); initramfs = true},
            {package = package dev.peios.live-root(); liveboot = false; initramfs = true},
            {package = package dev.example.motd()},
        ],
        initramfs = {symlinks = [{at = "init"; to = ":bin/busybox"}]; dirs = ["proc", "sys", "tmp", "dev"]},
    )
}

# `pekit run boot` boots the ISO with the terminal.
def build boot() { = qemu.launcher(build iso()) }

# The boot test: the ISO comes up as far as busybox's prompt, at speed
# where the machine has KVM.
#[device("kvm")]
#[timeout(5m)]
def test boots(iso: File = build iso()) {
    let run = qemu.boot(iso, until = "Please press Enter to activate this console.")
    assert run.status == 0, run.stdout
}
