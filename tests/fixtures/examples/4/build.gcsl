# Example 4, runnable: building someone else's code.
#
# zlib is fetched by its pinned hash, unpacked, and built with its own
# `./configure` and `make` as one step, in the build environment the
# workspace registers.
import unpack from archive
import "github.com/gcslib/buildenv"
import "github.com/gcslib/gcc"

def build zlib() {
    let src = unpack(
        fetch(
            "https://zlib.net/fossils/zlib-1.3.1.tar.gz",
            sha256 = "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23",
        ),
    )
    let out = buildenv.configure_make(src.dir("zlib-1.3.1"), configure = ["--static"])
    headers = [out.file("include/zlib.h"), out.file("include/zconf.h")]
    archive = out.file("lib/libz.a")
}

def build app() {
    let z = build zlib()
    let obj = gcc.compile(file("main.c"), headers = z.headers)
    = gcc.link([obj], libraries = [z.archive], output = "app")
}
