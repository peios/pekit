# ppk, built from its source in `src`, with the crates its `Cargo.lock`
# pins, as a static program.
import "github.com/gcslib/rust"

def build ppk() {
    = rust.cargo_build(dir("src"), rust.vendored(file("src/Cargo.lock")), bins = ["ppk"])
}

# ppk linked against glibc: the flags and the C compiler follow the target.
def build ppk_glibc() {
    = rust.cargo_build(
        dir("src"),
        rust.vendored(file("src/Cargo.lock")),
        bins = ["ppk"],
        target = "x86_64-unknown-linux-gnu",
    )
}

# ppk built one crate at a time: its kernel crate reads the kernel's
# sources beside it.
def build ppk_crates() {
    let ws = rust.workspace(
        dir("src"),
        rust.vendored(file("src/Cargo.lock")),
        crates = [{package = "peios-uapi"; data = [{at = "vendor/kernel"; place = dir("src/vendor/kernel")}]}],
    )
    = rust.bin(ws, "ppk")
}
