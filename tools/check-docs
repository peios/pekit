#!/bin/sh
# Check the authored Learn contribution and the man pages, with a
# caller-selected Trail build.
set -eu

repo=$(CDPATH="" cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo"
trail=${TRAIL:-trail}
"$trail" lint docs/learn
output=$(mktemp -d "${TMPDIR:-/tmp}/pekit-learn.XXXXXXXX")
trap 'rm -rf -- "$output"' EXIT HUP INT TERM
# A link to another product, such as GCSL's, resolves only in the combined
# Learn site, so this build allows dangling links and then fails on any but
# those. Build the combined site to check them.
if ! "$trail" build docs/learn --strict --allow-dangling-links --no-cache \
    --out "$output/site" 2>"$output/log"; then
    cat "$output/log" >&2
    exit 1
fi
dangling=$(grep -v "names unknown product" "$output/log" || true)
if [ -n "$dangling" ]; then
    printf '%s\n' "$dangling" >&2
    exit 1
fi
for page in man/*.[1-9]; do
    [ -e "$page" ] || continue
    warnings=$(groff -man -ww -z "$page" 2>&1)
    if [ -n "$warnings" ]; then
        printf '%s: %s\n' "$page" "$warnings" >&2
        exit 1
    fi
done
